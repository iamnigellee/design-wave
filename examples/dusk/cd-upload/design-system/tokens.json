{
  "$schema": "https://schemas.designtokens.org/2023/design-tokens.json",
  "meta": {
    "brand": "Dusk",
    "version": "1.0.0",
    "primaryMode": "dark"
  },

  "color": {
    "neutral": {
      "50":  { "$value": "#FAF8F4", "$type": "color" },
      "100": { "$value": "#EFEAE1", "$type": "color" },
      "200": { "$value": "#DCD4C7", "$type": "color" },
      "300": { "$value": "#B8AE9E", "$type": "color" },
      "400": { "$value": "#8E8473", "$type": "color" },
      "500": { "$value": "#6A6154", "$type": "color" },
      "600": { "$value": "#4A443A", "$type": "color" },
      "700": { "$value": "#2E2A24", "$type": "color" },
      "800": { "$value": "#1C1A16", "$type": "color" },
      "900": { "$value": "#121110", "$type": "color" },
      "950": { "$value": "#0A0908", "$type": "color" }
    },
    "signal": {
      "flax": { "$value": "#A89680", "$type": "color",
                "$description": "Only accent color. Signal-only: CTA / focus / error / selected. Decoration use forbidden." }
    },
    "semantic": {
      "bg": {
        "canvas":   { "$value": "{color.neutral.900}", "$type": "color" },
        "surface":  { "$value": "{color.neutral.950}", "$type": "color",
                      "$description": "Intentionally darker than canvas — cards recede into night." },
        "elevated": { "$value": "{color.neutral.800}", "$type": "color" }
      },
      "fg": {
        "primary":   { "$value": "{color.neutral.50}",  "$type": "color" },
        "secondary": { "$value": "{color.neutral.300}", "$type": "color" },
        "muted":     { "$value": "{color.neutral.400}", "$type": "color" }
      },
      "border": {
        "subtle": { "$value": "{color.neutral.800}", "$type": "color" },
        "strong": { "$value": "{color.neutral.700}", "$type": "color" }
      },
      "accent": {
        "primary": { "$value": "{color.signal.flax}", "$type": "color" }
      },
      "state": {
        "danger":  { "$value": "#8A4A3A", "$type": "color" },
        "warning": { "$value": "#8A7A3A", "$type": "color" },
        "success": { "$value": "#5A6A4A", "$type": "color" },
        "info":    { "$value": "{color.signal.flax}", "$type": "color" }
      }
    }
  },

  "typography": {
    "family": {
      "primary": { "$value": "Söhne, Inter, -apple-system, BlinkMacSystemFont, sans-serif", "$type": "fontFamily" },
      "mono":    { "$value": "ui-monospace, 'SF Mono', 'JetBrains Mono', monospace",        "$type": "fontFamily" }
    },
    "weight": {
      "regular": { "$value": 400, "$type": "fontWeight" },
      "medium":  { "$value": 500, "$type": "fontWeight",
                   "$description": "Weights 600+ are forbidden by brand rule." }
    },
    "scale": {
      "display": { "$type": "typography", "$value": { "fontFamily": "{typography.family.primary}", "fontSize": "40px", "lineHeight": 1.15, "fontWeight": 400, "letterSpacing": "-0.02em" } },
      "h1":      { "$type": "typography", "$value": { "fontFamily": "{typography.family.primary}", "fontSize": "28px", "lineHeight": 1.2,  "fontWeight": 500, "letterSpacing": "-0.01em" } },
      "h2":      { "$type": "typography", "$value": { "fontFamily": "{typography.family.primary}", "fontSize": "18px", "lineHeight": 1.3,  "fontWeight": 500 } },
      "body":    { "$type": "typography", "$value": { "fontFamily": "{typography.family.primary}", "fontSize": "16px", "lineHeight": 1.5,  "fontWeight": 400 } },
      "small":   { "$type": "typography", "$value": { "fontFamily": "{typography.family.primary}", "fontSize": "14px", "lineHeight": 1.5,  "fontWeight": 400 } },
      "micro":   { "$type": "typography", "$value": { "fontFamily": "{typography.family.primary}", "fontSize": "12px", "lineHeight": 1.4,  "fontWeight": 400, "letterSpacing": "0.05em" } }
    }
  },

  "spacing": {
    "0": { "$value": "0px",  "$type": "dimension" },
    "1": { "$value": "4px",  "$type": "dimension" },
    "2": { "$value": "8px",  "$type": "dimension" },
    "3": { "$value": "12px", "$type": "dimension" },
    "4": { "$value": "16px", "$type": "dimension" },
    "5": { "$value": "24px", "$type": "dimension" },
    "6": { "$value": "32px", "$type": "dimension" },
    "7": { "$value": "48px", "$type": "dimension" },
    "8": { "$value": "64px", "$type": "dimension" },
    "9": { "$value": "96px", "$type": "dimension" }
  },

  "radius": {
    "none": { "$value": "0px",  "$type": "dimension" },
    "sm":   { "$value": "2px",  "$type": "dimension" },
    "md":   { "$value": "4px",  "$type": "dimension",
              "$description": "Maximum radius by brand rule. Larger values forbidden." }
  },

  "shadow": {
    "$description": "No shadow tokens are defined. Elevation is communicated by 1px border + luminance step between surfaces. This absence is brand-load-bearing — do not introduce shadow tokens."
  },

  "motion": {
    "duration": {
      "fast": { "$value": "200ms", "$type": "duration" },
      "base": { "$value": "400ms", "$type": "duration" },
      "slow": { "$value": "600ms", "$type": "duration" }
    },
    "easing": {
      "standard": { "$value": "cubic-bezier(0.32, 0.72, 0.24, 1)", "$type": "cubicBezier" }
    },
    "reducedMotion": {
      "$value": "remove",
      "$description": "Strategy is 'remove' not 'reduce' — transitions dropped entirely under prefers-reduced-motion."
    }
  },

  "focusRing": {
    "width":  { "$value": "2px", "$type": "dimension" },
    "color":  { "$value": "{color.signal.flax}", "$type": "color" },
    "offset": { "$value": "2px", "$type": "dimension" }
  }
}
