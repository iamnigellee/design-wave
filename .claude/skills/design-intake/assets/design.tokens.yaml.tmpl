# design.tokens.yaml — {{BRAND_NAME}} v{{VERSION}}
# Generated by design-intake skill v4.5 · {{TIMESTAMP}}
#
# Every component references semantic tokens, never palette stops.
# Every material layer color references palette tokens, never raw hex.
# Every {...} reference must resolve (enforced by scripts/gate-check.py
# token-closure gate).

meta:
  brand: "{{BRAND_NAME}}"
  version: "{{VERSION}}"
  schema: "design-intake-v4.5"
  primary-mode: "{{DEFAULT_MODE}}"    # dark | light

# ---------------------------------------------------------------------------
# Positive constraints — self-imposed rules enforced by token-lint.py.
# Not overrideable within a run. See references/schema-projection.md.
# ---------------------------------------------------------------------------

positive_constraints:
  # Example: palette-lock
  # - id: palette-lock
  #   rule: "all color hex values must be subset of <source>"
  #   source: "https://lospec.com/palette-list/endesga-32"
  #   source_hex: [...]                  # optional explicit list
  #   scope: ["color.*", "material.*.color*"]
  #
  # Example: grid-8
  # - id: grid-8
  #   rule: "spacing, padding, margins are integer multiples of 8"
  #   n: 8
  #   scope: ["spacing.*", "layout.*", "components.*.base.padding"]
  #   exceptions: ["radius.hairline"]
  #
  # Example: motion-stepped-only
  # - id: motion-stepped-only
  #   rule: "motion.timing-fn types are 'steps' only"
  #
  # Example: radius-cap:4
  # - id: "radius-cap:4"
  #   rule: "radius ≤ 4 except named exceptions"
  #   exceptions: ["cta"]
  #
  # Example: weights-restricted
  # - id: weights-restricted
  #   rule: "typography weights drawn from allowed set only"
  #   allowed: [400, 500]

  {{#POSITIVE_CONSTRAINTS}}
  - id: "{{ID}}"
    rule: "{{RULE}}"
    scope: {{SCOPE_GLOBS}}
    {{#SOURCE}}source: "{{SOURCE}}"{{/SOURCE}}
    {{#EXCEPTIONS}}exceptions: {{EXCEPTIONS_LIST}}{{/EXCEPTIONS}}
  {{/POSITIVE_CONSTRAINTS}}

# ---------------------------------------------------------------------------
# Gate overrides — structured, not freeform.
# Every override entry is validated by scripts/gate-check.py.
# ---------------------------------------------------------------------------

overrides:
  {{#OVERRIDES}}
  - id: "{{OVERRIDE_ID}}"
    gate: "{{GATE_NAME}}"
    status: override
    reason:
      context-assumption: |
        {{CONTEXT_ASSUMPTION}}
      why-default-insufficient: |
        {{WHY_INSUFFICIENT}}
      upgrade-cost: |
        {{UPGRADE_COST}}
    scope:
      {{#SCOPE_GLOBS}}
      - "{{GLOB}}"
      {{/SCOPE_GLOBS}}
    enforce-elsewhere: {{ENFORCE_ELSEWHERE}}
  {{/OVERRIDES}}

# ---------------------------------------------------------------------------
# Color
# ---------------------------------------------------------------------------

color:
  # Palette stops — each entry carries hex + HSL-component form (for shadcn /
  # Tailwind runtime CSS variable usage).
  {{#COLOR_FAMILIES}}
  {{FAMILY_NAME}}:
    {{#STOPS}}
    {{STOP_NAME}}:
      hex: "{{HEX}}"
      hsl: "{{HSL_COMPONENTS}}"
    {{/STOPS}}
  {{/COLOR_FAMILIES}}

  # Neutral scale — target ≥ 9 stops with ≥ 5% L* delta between adjacent stops.
  # Override to fewer stops requires gate override (see overrides: above).
  neutral:
    {{#NEUTRAL_STOPS}}
    {{NAME}}:
      hex: "{{HEX}}"
      hsl: "{{HSL}}"
    {{/NEUTRAL_STOPS}}

  # Contrast tiers — layered enforcement.
  contrast:
    tier:
      text: "{{CONTRAST_TEXT_REQUIREMENT}}"           # AA | AAA
      ui: "{{CONTRAST_UI_REQUIREMENT}}"
      decoration: "{{CONTRAST_DECORATION_REQUIREMENT}}"   # AA | AAA | free
    scope-globs:
      text:       {{CONTRAST_TEXT_GLOBS}}
      ui:         {{CONTRAST_UI_GLOBS}}
      decoration: {{CONTRAST_DECORATION_GLOBS}}

  # Semantic tokens — every component references these, never palette stops.
  semantic:
    bg:
      canvas:     "{{BG_CANVAS_REF}}"
      surface:    "{{BG_SURFACE_REF}}"
      elevated:   "{{BG_ELEVATED_REF}}"
    fg:
      primary:    "{{FG_PRIMARY_REF}}"
      secondary:  "{{FG_SECONDARY_REF}}"
      muted:      "{{FG_MUTED_REF}}"
    border:
      subtle:     "{{BORDER_SUBTLE_REF}}"
      strong:     "{{BORDER_STRONG_REF}}"
    accent:
      primary:    "{{ACCENT_PRIMARY_REF}}"
      hover:      "{{ACCENT_HOVER_REF}}"
      active:     "{{ACCENT_ACTIVE_REF}}"
    state:
      danger:     {base: "{{DANGER_REF}}", locked: {{DANGER_LOCKED}}}
      warning:    {base: "{{WARNING_REF}}"}
      caution:    {base: "{{CAUTION_REF}}"}    # optional
      success:    {base: "{{SUCCESS_REF}}"}
      info:       {base: "{{INFO_REF}}"}

  # Dark-mode semantic tokens — explicit, not auto-invert.
  dark:
    semantic:
      bg:     { canvas: "{{DARK_BG_CANVAS}}", surface: "{{DARK_BG_SURFACE}}", elevated: "{{DARK_BG_ELEVATED}}" }
      fg:     { primary: "{{DARK_FG_PRIMARY}}", secondary: "{{DARK_FG_SECONDARY}}", muted: "{{DARK_FG_MUTED}}" }
      border: { subtle: "{{DARK_BORDER_SUBTLE}}", strong: "{{DARK_BORDER_STRONG}}" }
      accent: { primary: "{{DARK_ACCENT_PRIMARY}}", hover: "{{DARK_ACCENT_HOVER}}", active: "{{DARK_ACCENT_ACTIVE}}" }
      state:
        danger:  { base: "{{DARK_DANGER}}" }
        warning: { base: "{{DARK_WARNING}}" }
        success: { base: "{{DARK_SUCCESS}}" }
        info:    { base: "{{DARK_INFO}}" }

# ---------------------------------------------------------------------------
# Typography
# ---------------------------------------------------------------------------

typography:
  families:
    primary: "{{FONT_PRIMARY_STACK}}"
    mono:    "{{FONT_MONO_STACK}}"
  scale:
    {{#TYPE_SCALE}}
    {{ROLE}}:
      family: "{{FAMILY_REF}}"
      size:   {{SIZE_PX}}
      rem:    {{SIZE_REM}}
      line-height: {{LINE_HEIGHT}}
      weight: {{WEIGHT}}
      letter-spacing: "{{LETTER_SPACING}}"
      {{#FEATURE_SETTINGS}}feature-settings: "{{FEATURE_SETTINGS}}"{{/FEATURE_SETTINGS}}
      {{#NUMBER_STYLE}}number-style: {{NUMBER_STYLE}}{{/NUMBER_STYLE}}
    {{/TYPE_SCALE}}

# ---------------------------------------------------------------------------
# Spacing, radius, border, shadow
# ---------------------------------------------------------------------------

spacing: {{SPACING_ARRAY}}   # explicit array, never "multiples of N"

radius:
  default: {{RADIUS_DEFAULT}}
  {{#RADIUS_NAMED}}
  {{NAME}}: {{VALUE}}
  {{/RADIUS_NAMED}}

border:
  width:
    hairline: 1
    base: {{BORDER_BASE}}
    thick: {{BORDER_THICK}}
  style: "{{BORDER_STYLE}}"
  default-color: "{{BORDER_DEFAULT_COLOR_REF}}"

shadow:
  policy: {{SHADOW_POLICY}}    # scale | forbidden
  {{#SHADOW_SCALE}}
  sm:   "{{SHADOW_SM}}"
  base: "{{SHADOW_BASE}}"
  md:   "{{SHADOW_MD}}"
  lg:   "{{SHADOW_LG}}"
  {{/SHADOW_SCALE}}

# ---------------------------------------------------------------------------
# Motion (typed timing functions — v4.5)
# ---------------------------------------------------------------------------

motion:
  duration:
    instant: 0
    fast: {{DURATION_FAST}}
    base: {{DURATION_BASE}}
    slow: {{DURATION_SLOW}}
    dramatic: {{DURATION_DRAMATIC}}
  timing-fn:
    {{#TIMING_FNS}}
    {{FN_NAME}}:
      type: {{FN_TYPE}}    # bezier | steps | spring
      {{#IS_BEZIER}}value: "{{BEZIER_VALUE}}"{{/IS_BEZIER}}
      {{#IS_STEPS}}
      count: {{STEP_COUNT}}
      jump: {{STEP_JUMP}}        # start | end | both | none
      {{/IS_STEPS}}
      {{#IS_SPRING}}
      stiffness: {{SPRING_STIFFNESS}}
      damping: {{SPRING_DAMPING}}
      {{/IS_SPRING}}
    {{/TIMING_FNS}}
  usage:
    enter:        { duration: base, fn: "{{USAGE_ENTER_FN}}" }
    exit:         { duration: fast, fn: "{{USAGE_EXIT_FN}}" }
    hover:        { duration: fast, fn: "{{USAGE_HOVER_FN}}" }
    state-change: { duration: base, fn: "{{USAGE_STATE_FN}}" }
  reduced-motion:
    strategy: {{REDUCED_MOTION_STRATEGY}}   # reduce | remove
    duration-override: 0

# ---------------------------------------------------------------------------
# Focus ring & z-index
# ---------------------------------------------------------------------------

focus-ring:
  width: {{FOCUS_WIDTH}}
  style: "{{FOCUS_STYLE}}"
  color: "{{FOCUS_COLOR_REF}}"
  offset: {{FOCUS_OFFSET}}
  {{#HAS_OUTER_GLOW}}
  outer-glow:
    color: "{{GLOW_COLOR_REF}}"
    alpha: {{GLOW_ALPHA}}
    blur: {{GLOW_BLUR}}
  {{/HAS_OUTER_GLOW}}

z-index:
  base: 0
  dropdown: 10
  sticky: 20
  overlay: 30
  modal: 40
  toast: 50
  tooltip: 60

# ---------------------------------------------------------------------------
# Material (single + composite)
# ---------------------------------------------------------------------------

material:
  {{#MATERIAL_SINGLES}}
  {{TYPE_NAME}}: {{MATERIAL_BODY_YAML}}
  {{/MATERIAL_SINGLES}}
  {{#HAS_COMPOSITE}}
  composite:
    {{#COMPOSITE_STACKS}}
    {{STACK_NAME}}:
      layers:
        {{#LAYERS}}
        - index: {{INDEX}}
          type: {{TYPE}}
          {{#LAYER_FIELDS}}
          {{KEY}}: {{VALUE}}
          {{/LAYER_FIELDS}}
        {{/LAYERS}}
      render-order: "{{RENDER_ORDER}}"
      applied-to: {{APPLIED_TO}}
    {{/COMPOSITE_STACKS}}
  {{/HAS_COMPOSITE}}

# ---------------------------------------------------------------------------
# Layout (base + per-page deltas, v4.5)
# ---------------------------------------------------------------------------

layout:
  base:
    container:
      mode: {{CONTAINER_MODE}}       # fluid | fixed-max | full-bleed-per-section
      max-width: {{CONTAINER_MAX}}
      padding-x: { mobile: {{PAD_MOBILE}}, tablet: {{PAD_TABLET}}, desktop: {{PAD_DESKTOP}} }
    grid:
      mode: {{GRID_MODE}}              # standard-12 | broken-12 | full-bleed-stack
      columns: {{GRID_COLUMNS}}
      gap: {{GRID_GAP}}
      overflow-allowed: {{GRID_OVERFLOW}}
    density: {{DENSITY}}              # default | dense | sparse
    logical: {{LAYOUT_LOGICAL}}       # true for RTL support
  breakpoints:
    sm: 640
    md: 768
    lg: 1024
    xl: 1280
    "2xl": 1536
  primary-viewport:
    width: {{VIEWPORT_WIDTH}}
    height: {{VIEWPORT_HEIGHT}}
    device-pixel-ratio: {{VIEWPORT_DPR}}
    posture: "{{VIEWPORT_POSTURE}}"
  {{#HAS_HIDPI}}
  hidpi:
    strategy: {{HIDPI_STRATEGY}}     # integer-scale | browser-default | snap-to-grid
    base-unit: {{HIDPI_BASE}}
    scale@2x: 2
    scale@3x: 3
    image-rendering: {{HIDPI_IMAGE_RENDERING}}
    font-smoothing: {{HIDPI_FONT_SMOOTHING}}
  {{/HAS_HIDPI}}
  page:
    {{#PAGE_DELTAS}}
    {{PAGE_NAME}}:
      {{#DELTAS}}{{KEY}}: {{VALUE}}
      {{/DELTAS}}
      rationale: "{{RATIONALE}}"
    {{/PAGE_DELTAS}}
  {{#HAS_RTL}}
  rtl:
    enabled: true
    number-direction: ltr   # numbers stay LTR even in RTL locales
  {{/HAS_RTL}}

# ---------------------------------------------------------------------------
# Components
# ---------------------------------------------------------------------------

components:
  base:
    interactive-5state:
      states: [default, hover, focus, active, disabled]
    form-5state:
      states: [default, hover, focus, disabled, error]

  {{#COMPONENTS}}
  {{COMPONENT_NAME}}:
    extends: "{{EXTENDS}}"
    base: {{BASE_BLOCK_YAML}}
    {{#OMIT_STATES}}omit-states: {{OMIT_STATES_LIST}}{{/OMIT_STATES}}
    {{#HAS_VARIANTS}}
    variants:
      {{#VARIANTS}}
      {{VARIANT_NAME}}:
        {{#STATES}}{{STATE_NAME}}: {{STATE_BLOCK_YAML}}
        {{/STATES}}
      {{/VARIANTS}}
    {{/HAS_VARIANTS}}
    {{#HAS_STATES}}
    {{#STATES}}{{STATE_NAME}}: {{STATE_BLOCK_YAML}}
    {{/STATES}}
    {{/HAS_STATES}}
  {{/COMPONENTS}}
